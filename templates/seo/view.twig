{% extends "content-intelligence/_layouts/cp" %}

{% set title = "SEO Audit: " ~ entry.title %}
{% set selectedSubnavItem = 'seo' %}

{% block pageActions %}
    <a href="{{ cpUrl('content-intelligence/seo') }}" class="btn">
        &larr; {{ "Back to SEO Audits"|t('content-intelligence') }}
    </a>
    <a href="{{ entry.cpEditUrl }}" target="_blank" rel="noopener" class="btn">
        {{ "Edit in Craft"|t('content-intelligence') }} &nearr;
    </a>
    <form method="post" action="{{ cpUrl('content-intelligence/audit/audit-entry/' ~ entry.id) }}" style="display: inline-block;">
        {{ csrfInput() }}
        {{ actionInput('content-intelligence/audit/audit-entry') }}
        <input type="hidden" name="entryId" value="{{ entry.id }}">
        {{ redirectInput('content-intelligence/seo/' ~ entry.id) }}
        <button type="submit" class="btn submit">
            {{ "Re-Audit SEO"|t('content-intelligence') }}
        </button>
    </form>
{% endblock %}

{% block ciContent %}
    <!-- Google SERP Snippet Preview Card -->
    <div class="ci-panel">
        <div class="ci-panel-header">
            <h2>{{ "Google Search Result Preview"|t('content-intelligence') }}</h2>
            <span style="font-size: 0.85rem; color: #64748b;">{{ "Simulated SERP Display"|t('content-intelligence') }}</span>
        </div>
        <div class="ci-panel-body" style="background: #fafafa;">
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; max-width: 650px; font-family: Arial, sans-serif;">
                <div style="font-size: 0.85rem; color: #202124; line-height: 1.3; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                    <span style="color: #4d5156;">{{ currentSite.name }}</span>
                    <span style="color: #70757a;">&rsaquo;</span>
                    <span style="color: #4d5156; word-break: break-all;">{{ serp.url }}</span>
                </div>
                <div style="font-size: 1.25rem; color: #1a0dab; line-height: 1.3; margin-bottom: 0.35rem; font-weight: normal; cursor: pointer;">
                    {{ serp.title }}
                </div>
                <div style="font-size: 0.9rem; color: #4d5156; line-height: 1.45;">
                    {{ serp.description }}
                </div>
            </div>

            <!-- Length Meters -->
            <div style="display: flex; gap: 2rem; margin-top: 1.25rem;">
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.35rem;">
                        <span><strong>{{ "Title Length"|t('content-intelligence') }}:</strong> {{ serp.titleLength }} / 60 characters</span>
                        <span class="{% if serp.titleLength >= 30 and serp.titleLength <= 60 %}ci-stat-score-good{% else %}ci-stat-score-warning{% endif %}">
                            {% if serp.titleLength >= 30 and serp.titleLength <= 60 %}Optimal{% elseif serp.titleLength < 30 %}Too Short{% else %}Too Long{% endif %}
                        </span>
                    </div>
                    <div style="height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden;">
                        <div style="width: {{ min(100, (serp.titleLength / 60 * 100)) }}%; height: 100%; background: {% if serp.titleLength >= 30 and serp.titleLength <= 60 %}#10b981{% elseif serp.titleLength < 30 %}#f59e0b{% else %}#ef4444{% endif %};"></div>
                    </div>
                </div>

                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.35rem;">
                        <span><strong>{{ "Meta Description"|t('content-intelligence') }}:</strong> {{ serp.descriptionLength }} / 160 characters</span>
                        <span class="{% if serp.descriptionLength >= 70 and serp.descriptionLength <= 160 %}ci-stat-score-good{% else %}ci-stat-score-warning{% endif %}">
                            {% if serp.descriptionLength >= 70 and serp.descriptionLength <= 160 %}Optimal{% elseif serp.descriptionLength < 70 %}Too Short{% else %}Too Long{% endif %}
                        </span>
                    </div>
                    <div style="height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden;">
                        <div style="width: {{ min(100, (serp.descriptionLength / 160 * 100)) }}%; height: 100%; background: {% if serp.descriptionLength >= 70 and serp.descriptionLength <= 160 %}#10b981{% elseif serp.descriptionLength < 70 %}#f59e0b{% else %}#ef4444{% endif %};"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SEO Findings List -->
    <div class="ci-panel">
        <div class="ci-panel-header">
            <h2>{{ "SEO Audit Findings & Recommendations"|t('content-intelligence') }}</h2>
            <span class="ci-severity-badge {% if audit.seoScore >= 80 %}ci-severity-good{% elseif audit.seoScore >= 50 %}ci-severity-warning{% else %}ci-severity-critical{% endif %}">
                {{ "SEO Score"|t('content-intelligence') }}: {{ audit.seoScore }}/100
            </span>
        </div>
        <div class="ci-panel-body">
            {% if results|length %}
                <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                    {% for result in results %}
                        <div style="border: 1px solid var(--gray-200, #e2e8f0); border-radius: 8px; padding: 1.25rem; background: {% if result.severity == 'critical' %}#fef2f2{% elseif result.severity == 'warning' %}#fffbeb{% elseif result.severity == 'notice' %}#f0f9ff{% else %}#f0fdf4{% endif %};">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
                                <div style="display: flex; align-items: center; gap: 0.75rem;">
                                    <span class="ci-severity-badge ci-severity-{{ result.severity }}">
                                        {{ result.severity|upper }}
                                    </span>
                                    <h3 style="margin: 0; font-size: 1.05rem; font-weight: 600; color: #1e293b;">
                                        {{ result.title }}
                                    </h3>
                                </div>
                                <span style="font-size: 0.8rem; color: #64748b; font-family: monospace;">
                                    {{ result.ruleId }}
                                </span>
                            </div>

                            <p style="margin: 0.5rem 0; color: #334155; font-size: 0.95rem;">
                                {{ result.description }}
                            </p>

                            {% if result.recommendation %}
                                <div style="margin-top: 0.75rem; padding: 0.75rem 1rem; background: rgba(255, 255, 255, 0.7); border-radius: 6px; border-left: 3px solid {% if result.severity == 'critical' %}#ef4444{% elseif result.severity == 'warning' %}#f59e0b{% else %}#10b981{% endif %};">
                                    <strong style="color: #0f172a; font-size: 0.85rem;">{{ "Recommendation"|t('content-intelligence') }}:</strong>
                                    <span style="color: #334155; font-size: 0.9rem; margin-left: 0.35rem;">{{ result.recommendation }}</span>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="notice">
                    <p>{{ "No SEO issues detected for this entry."|t('content-intelligence') }}</p>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- AI SEO Intelligence Panel (Pro & Agency) -->
    <div class="ci-panel" id="ci-ai-seo-panel">
        <div class="ci-panel-header" style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <h2 style="margin: 0;">{{ "AI SEO Intelligence"|t('content-intelligence') }}</h2>
                <span class="ci-edition-badge ci-badge-pro">{{ "Pro & Agency"|t('content-intelligence') }}</span>
            </div>
            <span style="font-size: 12px; color: #64748b;">
                {{ "Search Intent • Topical Depth • Semantic Entities • Strategic Differentiation"|t('content-intelligence') }}
            </span>
        </div>

        <div class="ci-panel-body">
            {% if not hasPro %}
                <div class="ci-upgrade-banner" style="margin-bottom: 0;">
                    <h3>{{ "Unlock AI SEO Intelligence with Pro"|t('content-intelligence') }}</h3>
                    <p>{{ "Analyze real search intent fulfillment, detect missing topical subtopics, identify high-authority semantic entities, and receive competitive angle advice tailored to your content."|t('content-intelligence') }}</p>
                    <a href="https://plugins.craftcms.com" target="_blank" class="btn submit" style="margin-top: 0.75rem;">{{ "Upgrade to Pro"|t('content-intelligence') }}</a>
                </div>
            {% else %}
                {% if not aiHealth.configured %}
                    <div style="background: #fffbeb; border: 1px solid #fef3c7; border-radius: 8px; padding: 1rem; margin-bottom: 1.25rem; color: #92400e;">
                        <strong>{{ "OpenAI API Key Required"|t('content-intelligence') }}:</strong>
                        <span style="font-size: 13px; margin-left: 0.35rem;">{{ "Please configure your OpenAI API key in Settings to run AI SEO evaluations."|t('content-intelligence') }}</span>
                        <a href="{{ cpUrl('content-intelligence/settings') }}" target="_blank" class="btn small" style="margin-left: 0.75rem;">{{ "Configure"|t('content-intelligence') }}</a>
                    </div>
                {% endif %}

                <!-- Controls -->
                <div style="display: flex; gap: 1rem; align-items: flex-end; margin-bottom: 1.5rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem;">
                    <div style="flex: 1;">
                        <label for="ci-target-keyword" style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 0.35rem; color: #334155;">
                            {{ "Focus Target Keyword / Query (Optional):"|t('content-intelligence') }}
                        </label>
                        <input type="text" id="ci-target-keyword" class="text fullwidth" value="{{ entry.title }}" placeholder="{{ "e.g. senior living directory"|t('content-intelligence') }}">
                    </div>
                    <div>
                        <button type="button" id="ci-btn-run-ai-seo" class="btn submit" style="display: flex; align-items: center; gap: 0.5rem; background: #6366f1; border-color: #6366f1; color: #fff;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <span>{{ "Run AI SEO Intelligence Audit"|t('content-intelligence') }}</span>
                        </button>
                    </div>
                    <span id="ci-ai-seo-spinner" class="spinner hidden" style="margin-bottom: 0.5rem;"></span>
                </div>

                <!-- Results Container -->
                <div id="ci-ai-seo-results" style="display: none; display: flex; flex-direction: column; gap: 1.5rem;">
                    <!-- Row 1: Search Intent & Coverage Summary -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                        <!-- Intent Card -->
                        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; box-shadow: 0 1px 2px rgba(0,0,0,0.03);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <strong style="font-size: 13px; text-transform: uppercase; color: #64748b; letter-spacing: 0.05em;">{{ "Search Intent Classification"|t('content-intelligence') }}</strong>
                                <span id="ci-ai-intent-rating" style="font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 9999px;"></span>
                            </div>
                            <div style="margin-bottom: 0.75rem;">
                                <span id="ci-ai-intent-badge" style="display: inline-block; font-size: 1.1rem; font-weight: 700; color: #0f172a; text-transform: uppercase;"></span>
                            </div>
                            <p id="ci-ai-intent-exp" style="font-size: 13px; color: #475569; margin: 0; line-height: 1.5;"></p>
                        </div>

                        <!-- Coverage Card -->
                        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; box-shadow: 0 1px 2px rgba(0,0,0,0.03);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <strong style="font-size: 13px; text-transform: uppercase; color: #64748b; letter-spacing: 0.05em;">{{ "Topic Depth & Completeness"|t('content-intelligence') }}</strong>
                                <span id="ci-ai-coverage-score" style="font-size: 13px; font-weight: 700; color: #16a34a;"></span>
                            </div>
                            <div style="margin-bottom: 0.5rem; font-size: 13px; color: #334155;">
                                {{ "Primary Subject: "|t('content-intelligence') }}<strong id="ci-ai-primary-topic"></strong>
                            </div>
                            <div>
                                <span style="font-size: 12px; color: #64748b; display: block; margin-bottom: 0.25rem;">{{ "Covered Subtopics:"|t('content-intelligence') }}</span>
                                <div id="ci-ai-covered-subtopics" style="display: flex; flex-wrap: wrap; gap: 0.35rem;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Missing Subtopics & Semantic Entities -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                        <!-- Missing Subtopics (Gaps) -->
                        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; box-shadow: 0 1px 2px rgba(0,0,0,0.03);">
                            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
                                <span style="color: #d97706; font-size: 16px;">⚠️</span>
                                <strong style="font-size: 14px; color: #0f172a;">{{ "Content Gaps & Expected Subtopics"|t('content-intelligence') }}</strong>
                            </div>
                            <p style="font-size: 12px; color: #64748b; margin-bottom: 0.75rem;">
                                {{ "Searchers and search algorithms expect these subtopics when researching this theme:"|t('content-intelligence') }}
                            </p>
                            <ul id="ci-ai-missing-subtopics" style="margin: 0 0 1rem 0; padding-left: 1.25rem; font-size: 13px; color: #334155; line-height: 1.6;"></ul>

                            <strong style="font-size: 12px; color: #64748b; display: block; margin-bottom: 0.25rem;">{{ "Suggested Heading Additions:"|t('content-intelligence') }}</strong>
                            <div id="ci-ai-suggested-headings" style="display: flex; flex-direction: column; gap: 0.35rem;"></div>
                        </div>

                        <!-- Semantic Entities -->
                        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; box-shadow: 0 1px 2px rgba(0,0,0,0.03);">
                            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
                                <span style="color: #6366f1; font-size: 16px;">💎</span>
                                <strong style="font-size: 14px; color: #0f172a;">{{ "Semantic Entity & LSI Opportunities"|t('content-intelligence') }}</strong>
                            </div>
                            <p style="font-size: 12px; color: #64748b; margin-bottom: 0.75rem;">
                                {{ "Entities naturally associated with this topic that reinforce semantic authority:"|t('content-intelligence') }}
                            </p>
                            <div id="ci-ai-semantic-keywords" style="display: flex; flex-direction: column; gap: 0.5rem;"></div>
                        </div>
                    </div>

                    <!-- Row 3: Differentiation Angle & Action Items -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                        <!-- Differentiation Angle -->
                        <div style="background: #fdf4ff; border: 1px solid #f0abfc; border-radius: 8px; padding: 1.25rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                <strong style="font-size: 14px; color: #86198f;">{{ "Competitive Differentiation Angle"|t('content-intelligence') }}</strong>
                                <span id="ci-ai-uniqueness-score" style="font-size: 11px; font-weight: 700; background: #fae8ff; color: #86198f; padding: 2px 7px; border-radius: 9999px;"></span>
                            </div>
                            <p id="ci-ai-diff-angle" style="font-size: 13px; color: #701a75; margin: 0; line-height: 1.6;"></p>
                        </div>

                        <!-- Action Items -->
                        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 1.25rem;">
                            <strong style="font-size: 14px; color: #166534; display: block; margin-bottom: 0.5rem;">
                                {{ "Prioritized SEO Action Roadmap"|t('content-intelligence') }}
                            </strong>
                            <ol id="ci-ai-prioritized-actions" style="margin: 0; padding-left: 1.25rem; font-size: 13px; color: #14532d; line-height: 1.6;"></ol>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    {% js %}
        $('#ci-btn-run-ai-seo').on('click', function() {
            var $btn = $(this);
            var $spinner = $('#ci-ai-seo-spinner');
            var keyword = $('#ci-target-keyword').val();

            $btn.addClass('disabled');
            $spinner.removeClass('hidden');

            Craft.postActionRequest('content-intelligence/seo/analyze-ai-seo', {
                entryId: {{ entry.id }},
                targetKeyword: keyword
            }, function(response) {
                $btn.removeClass('disabled');
                $spinner.addClass('hidden');

                if (response.success && response.analysis) {
                    var a = response.analysis;

                    // 1. Search Intent
                    if (a.searchIntent) {
                        $('#ci-ai-intent-badge').text(a.searchIntent.primaryIntent || 'N/A');
                        var rating = a.searchIntent.intentMatchRating || 'Moderate';
                        var ratingColor = rating.toLowerCase() === 'strong' ? '#dcfce7; color:#166534' : (rating.toLowerCase() === 'moderate' ? '#fef3c7; color:#92400e' : '#fee2e2; color:#991b1b');
                        $('#ci-ai-intent-rating').attr('style', 'font-size:11px; font-weight:700; padding:2px 8px; border-radius:9999px; background:' + ratingColor).text(rating + ' Alignment');
                        $('#ci-ai-intent-exp').text(a.searchIntent.explanation || '');
                    }

                    // 2. Topic Coverage
                    if (a.topicCoverage) {
                        $('#ci-ai-coverage-score').text((a.topicCoverage.coverageScore || 80) + '% Coverage');
                        $('#ci-ai-primary-topic').text(a.topicCoverage.primaryTopic || 'General');

                        var $covered = $('#ci-ai-covered-subtopics').empty();
                        (a.topicCoverage.coveredSubtopics || []).forEach(function(sub) {
                            $covered.append('<span style="font-size:11px; background:#f1f5f9; color:#334155; padding:2px 6px; border-radius:4px;">✓ ' + sub + '</span>');
                        });

                        var $missing = $('#ci-ai-missing-subtopics').empty();
                        (a.topicCoverage.missingSubtopics || []).forEach(function(m) {
                            $missing.append('<li>' + m + '</li>');
                        });

                        var $headings = $('#ci-ai-suggested-headings').empty();
                        (a.topicCoverage.suggestedHeadings || []).forEach(function(h) {
                            $headings.append('<code style="display:block; padding:4px 8px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:4px; font-size:11px; color:#4338ca;">' + h + '</code>');
                        });
                    }

                    // 3. Semantic Keywords
                    var $sem = $('#ci-ai-semantic-keywords').empty();
                    (a.semanticKeywords || []).forEach(function(item) {
                        $sem.append('<div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:0.5rem 0.75rem;">' +
                            '<strong style="font-size:12px; color:#1e293b;">' + item.term + '</strong>' +
                            '<div style="font-size:11px; color:#64748b; margin-top:2px;">' + item.context + '</div>' +
                        '</div>');
                    });

                    // 4. Differentiation
                    if (a.differentiation) {
                        $('#ci-ai-uniqueness-score').text((a.differentiation.uniquenessScore || 70) + '% Uniqueness');
                        $('#ci-ai-diff-angle').text(a.differentiation.competitiveAngle || '');
                    }

                    // 5. Actions
                    var $actions = $('#ci-ai-prioritized-actions').empty();
                    (a.prioritizedActions || []).forEach(function(act) {
                        $actions.append('<li style="margin-bottom:0.25rem;">' + act + '</li>');
                    });

                    $('#ci-ai-seo-results').show();
                    Craft.cp.displayNotice('AI SEO Intelligence audit complete.');
                } else {
                    Craft.cp.displayError(response.message || 'Error executing AI SEO audit.');
                }
            });
        });
    {% endjs %}
{% endblock %}
